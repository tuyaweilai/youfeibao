# 后端（yudao-server，spring profile = local）所需环境变量。
#
# 用法：复制为 .env 并填值，然后启动前 source（见 AGENTS.md）：
#   cp .env.example .env && $EDITOR .env
#   set -a; source .env; set +a
#
# .env 不入库（.gitignore 已忽略）；本文件只放变量名与说明。
# 注意：值里含 `&` 等 shell 特殊字符时要加单引号，否则 `source .env` 会被截断。

# ---- MySQL ----
# 默认指向共享开发库；要连本地 docker-compose 的 MySQL 就覆盖为：
#   jdbc:mysql://127.0.0.1:3306/ruoyi-vue-pro?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true&rewriteBatchedStatements=true
MYSQL_URL=
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ---- 加解密盐（yudao.encryptor.password）----
# 用于加密落库的配置项，务必设置；生成：https://www.imaegoo.com/2020/aes-key-generator/
YUDAO_ENCRYPTOR_PASSWORD=

# ---- 微信公众号 / 小程序（只有用到登录、消息时才需要）----
WX_MP_APP_ID=
WX_MP_SECRET=
WX_MINIAPP_APP_ID=
WX_MINIAPP_SECRET=

# ---- 第三方登录（钉钉 / 企业微信）----
JUSTAUTH_DINGTALK_CLIENT_ID=
JUSTAUTH_DINGTALK_CLIENT_SECRET=
JUSTAUTH_WECOM_CLIENT_ID=
JUSTAUTH_WECOM_CLIENT_SECRET=

# ---- 其他 ----
# Redis 默认端口；compose 里映射的是宿主 16382，故本机联调设为 16382。
REDIS_HOST=127.0.0.1
REDIS_PORT=16382
REDIS_DATABASE=0
TENCENT_LBS_KEY=
RABBITMQ_PASSWORD=rabbit
IOT_EMQ_USERNAME=
IOT_EMQ_PASSWORD=

# ---- 工行融 e 聚（只有真实联调才需要）----
# 本地默认 ICBC_GATEWAY_MODE=fake，走假适配层、不触网。
ICBC_GATEWAY_MODE=fake
ICBC_APP_ID=
ICBC_OUT_VENDOR_ID=
ICBC_PRIVATE_KEY=
ICBC_APIGW_PUBLIC_KEY=
ICBC_AES_KEY=
ICBC_SM2_PRIVATE_KEY=
ICBC_SM2_APIGW_PUBLIC_KEY=
ICBC_BASE_URL=https://gw.open.icbc.com.cn
# 公开令牌（自然人免登录端点）签名密钥，生产必填
ICBC_PUBLIC_TOKEN_SECRET=

# 出售者触达（#36）与实名回跳（#82）：短信默认关闭（费用与到达率是运营成本）；
# 开启后还需要真实短信渠道与签名报备。SELLER_APP_URL 用于拼一次性令牌链接，
# 也是实人认证完成后工行结果页「确认」的跳转地址基地址（#82）——**实名发起时就需要**，
# 缺了它发起实名会直接报「尚未配置自然人端入口地址」。
# 本地联调填自然人端 H5：http://localhost:5174（场站二维码链接也指向它）。
ICBC_NOTIFY_SMS_ENABLED=false
ICBC_SELLER_APP_URL=
ICBC_STATION_ENTRY_URL=

# ---- 腾讯云卡证识别（#93，ADR 0037；只有真实识别才需要）----
# 本地默认 ICBC_CARD_RECOGNITION_PROVIDER=stub，不触网、向导退化为手工录入。
# 密钥只落后端；要启用真实识别，把 provider 设为 tencent 并填下面两项密钥。
ICBC_CARD_RECOGNITION_PROVIDER=stub
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou

# ---- AI（本平台不用，留空即可）----
AI_QIANFAN_API_KEY=
AI_QIANFAN_SECRET_KEY=
AI_ZHIPUAI_API_KEY=
AI_OPENAI_API_KEY=
AI_STABILITYAI_API_KEY=
AI_DEEPSEEK_API_KEY=
AI_DOUBAO_API_KEY=
AI_SILICONFLOW_API_KEY=
AI_XINGHUO_APP_KEY=
AI_XINGHUO_SECRET_KEY=
AI_MIDJOURNEY_API_KEY=
KD_NIAO_API_KEY=
KD100_KEY=
KD100_CUSTOMER=
