# ============================================================================
# 有废宝 · 生产环境变量（/opt/youfeibao/.env.prod，权限 600）
# 由 docker compose --env-file .env.prod 读取
# ============================================================================

# ---- MySQL（独立实例 yfb-mysql，与 nhzt-mysql / xcgl 等互不干扰）----
MYSQL_ROOT_PASSWORD=<部署时填>
MYSQL_DATABASE=ruoyi-vue-pro
MYSQL_URL='jdbc:mysql://yfb-mysql:3306/ruoyi-vue-pro?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true&rewriteBatchedStatements=true&connectTimeout=60000&socketTimeout=60000&autoReconnect=true&maxReconnects=3'
MYSQL_USERNAME=root
MYSQL_PASSWORD=<部署时填>

# ---- Redis（yfb-redis，带密码 + AOF）----
REDIS_HOST=yfb-redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=<部署时填>

# ---- 加解密盐 ----
# ★ 必须与本地一致：库里已有用它加密过的字段，换值会导致解不开。
#   本地库 infra_data_source_config 为空表，后续想换强口令，清空该表后即可轮换。
YUDAO_ENCRYPTOR_PASSWORD=<部署时填>

# ---- 工行融 e 聚 ----
# 本机（47.99.49.104）连不上工行网关（apipcs4.dccnet.com.cn:443 超时），
# 与本地现象一致；白名单解决前保持 fake。
ICBC_GATEWAY_MODE=fake
# ★ 与本地一致：icbc_public_token 表已用它签过令牌
ICBC_PUBLIC_TOKEN_SECRET=<部署时填>

# 自然人端 / 场站二维码 / 工行回跳地址
# TODO 宝塔申请 SSL 后，把下面 4 处改成 https://
ICBC_SELLER_APP_URL=http://yfbgeren.baibaitan.com
ICBC_STATION_ENTRY_URL=http://yfbgeren.baibaitan.com
ICBC_INVOICE_JUMP_URL_BASE=http://yfbgeren.baibaitan.com
ICBC_PUBLIC_BASE_URL=http://yfbgeren.baibaitan.com
ICBC_PUBLIC_API_PREFIX=/admin-api
ICBC_NOTIFY_SMS_ENABLED=false

ICBC_CARD_RECOGNITION_PROVIDER=stub

# ---- 短信 / 验证码 ----
YUDAO_SMS_CODE_MAX_PER_DAY=0

# ---- 三方（用到再填）----
WX_MP_APP_ID=
WX_MP_SECRET=
WX_MINIAPP_APP_ID=
WX_MINIAPP_SECRET=
JUSTAUTH_DINGTALK_CLIENT_ID=
JUSTAUTH_DINGTALK_CLIENT_SECRET=
JUSTAUTH_WECOM_CLIENT_ID=
JUSTAUTH_WECOM_CLIENT_SECRET=
TENCENT_LBS_KEY=
