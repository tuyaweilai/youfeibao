# 生产环境：只在打包时使用
NODE_ENV=production

# 标题
VITE_APP_TITLE=有废宝

VITE_DEV=false

# 请求路径
# ★ 必须为空：axios 的 base_url = VITE_BASE_URL + VITE_API_URL（src/config/axios/config.ts）。
#   填成 http://localhost:48080 会把这个字面量打进产物，浏览器里所有接口都打向
#   **访问者自己的 localhost**，后台直接全废。为空即走同源 /admin-api，由 nginx 反代。
VITE_BASE_URL=''

# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server

# 接口地址
VITE_API_URL=/admin-api

# 是否删除debugger
VITE_DROP_DEBUGGER=true

# 是否删除console.log
VITE_DROP_CONSOLE=true

# 是否sourcemap
VITE_SOURCEMAP=false

# 打包路径
VITE_BASE_PATH=/

# 输出路径
VITE_OUT_DIR=dist-prod

# 商城H5会员端域名
# 脚手架遗留：指向 yudao 官方演示商城，本项目不用
VITE_MALL_H5_DOMAIN=''

# GoView域名
# 脚手架遗留：GoView 大屏演示地址，本项目不用
VITE_GOVIEW_URL=''
# ---- 生产：绝不预填登录框 ----
# 基础 .env 里 VITE_APP_DEFAULT_LOGIN_* 会被 Vite 替换成字面量打进 JS 产物，
# 线上包能直接 grep 到明文口令；这里覆盖为空，使 LoginForm 落到 `|| ''` 分支。
# 租户名同理去掉——租户标识不该由前端告诉访问者。
# 本地开发仍用 .env 的默认值，不受影响。
VITE_APP_DEFAULT_LOGIN_TENANT=''
VITE_APP_DEFAULT_LOGIN_USERNAME=''
VITE_APP_DEFAULT_LOGIN_PASSWORD=''

# ---- 生产：关闭百度统计 ----
# 基础 .env 里 VITE_APP_BAIDU_CODE 是脚手架作者的统计 ID，线上会持续把
# 本系统页面的访问行为上报到百度。src/plugins/tongji/index.ts 在值为空时自动不加载。
VITE_APP_BAIDU_CODE=''

# ---- 生产：关闭图形验证码 ----
# 后端 yudao.captcha.enable 校验挂在 /admin-api/system/auth/login 上，而司机端/企业收货端
# （uni-app）用的是同一个接口且没有验证码 UI，开了会把这两端一起拦死（"验证码不能为空"）。
# 后端已置 false（与本地一致），前端 UI 跟着关，避免用户白解一次滑块。
# 待办：若之后要给后台单独加验证码，需要先给 uniapp 拆出独立登录接口，别只改 yudao.captcha.enable。
VITE_APP_CAPTCHA_ENABLE=false
