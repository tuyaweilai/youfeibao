{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "sourceMap": true,
    "baseUrl": ".",
    "types": ["@dcloudio/types", "vite/client"],
    "paths": {
      "@/*": ["src/*"],
      "@youfeibao/field-shared": ["../packages/field-shared/src/index.ts"],
      "@youfeibao/field-shared/*": ["../packages/field-shared/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "vite.config.ts"],
  "exclude": ["node_modules", "unpackage", "dist"]
}
